# ─── hbbs / hbbr (servidor OSS) ────────────────────────────────────────────────
# Host público que los clientes RustDesk usarán como ID y Relay Server.
# Debe resolver (registro A) a la IP pública del servidor donde corre Coolify.
# Ejemplo: rustdesk.zionnet.com.mx
RUSTDESK_RELAY_HOST=rustdesk.tu-dominio.com

# ─── rustdesk-api (panel de admin) ─────────────────────────────────────────────
# Dominio HTTP del panel. Registro A propio apuntando al mismo VPS.
# Este SÍ va detrás de Traefik (TLS automático por Coolify).
# Ejemplo: rustdesk-panel.zionnet.com.mx
RUSTDESK_API_HOST=rustdesk-panel.tu-dominio.com

# Clave pública de hbbs. Obtenla con (ver README §5):
#   docker cp <contenedor-hbbs>:/root/id_ed25519.pub /tmp/k && cat /tmp/k
# Pégala SIN salto de línea. Termina en '='.
RUSTDESK_KEY=

# Secreto para firmar los JWT de sesión del panel. Genera uno con:
#   openssl rand -hex 32
RUSTDESK_API_JWT_KEY=

# Idioma del panel: en | zh-CN
RUSTDESK_API_LANG=en

# Zona horaria de los contenedores
TZ=America/Mexico_City
